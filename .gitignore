# 忽略日志文件
*.log

# 忽略编译产物
*.exe
*.dll
*.so
*.dylib

# 忽略 node_modules
node_modules/

# 忽略构建产物
dist/
build/

# 忽略 IDE 配置
.vscode/
.idea/
*.swp
*.swo
*~

# 忽略数据库文件
*.db
*.sqlite
*.sqlite3

# 忽略系统文件
.DS_Store
Thumbs.db

# 忽略根目录的文档文件（保留项目核心代码）
*.md
*.txt
!src_5-2/**/*.md

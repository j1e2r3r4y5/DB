hummingbird-master/
ML307C_*/

# 忽略压缩包
*.zip
*.rar
*.7z

# 忽略文档文件
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.vsdx
*.xls
*.xlsx

# 忽略临时文件
~$*
*.tmp
*.pyc
